# Copy to .env.local and fill in with your Supabase project's values
# (Project Settings → API in the Supabase dashboard). .env.local is
# gitignored — never commit real credentials. Expo only exposes env vars
# prefixed with EXPO_PUBLIC_ to app code.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — error monitoring. Leave unset to no-op entirely (no Sentry
# project needed yet). Get a DSN from sentry.io once you create one.
EXPO_PUBLIC_SENTRY_DSN=
